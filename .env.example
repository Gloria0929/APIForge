# 服务
PORT=3000
NODE_ENV=development

# 数据库（默认 SQLite）
DB_TYPE=sqlite
DB_SQLITE_PATH=apiforge.db
DB_SYNC=true

# PostgreSQL（可选，DB_TYPE=postgres 时使用）
# DATABASE_URL=
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_NAME=apiforge
# DB_SSL=false

# 版本检查：优先按 registry 接口自动检测（需 DOCKER_IMAGE 含完整仓库地址）
# 若检测失败或未配置 DOCKER_IMAGE，则回退到 VERSION_LATEST
# VERSION_LATEST=1.0.5
# 可选：更新说明链接
# VERSION_RELEASE_URL=https://github.com/Gloria0929/APIForge/releases

# Docker 更新（需挂载 -v /var/run/docker.sock:/var/run/docker.sock）
# 更新时执行：docker stop apiforge && docker rm -f apiforge && docker run ...
# DOCKER_IMAGE 已写入镜像默认值（构建时 --build-arg），运行时可覆盖
# 注意：仓库地址必须带主机名。只写 <命名空间>/<仓库> 会被解析成 Docker Hub。
# DOCKER_IMAGE=crpi-xxxxxxxx.<region>.personal.cr.aliyuncs.com/<命名空间>/apiforge:latest
# DOCKER_DATA_VOLUME=apiforge-data

# 指向装了 locust 的 Python 解释器（绝对路径）
APIFORGE_LOCUST_PYTHON=
